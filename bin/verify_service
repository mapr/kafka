#!/bin/bash

MAPR_HOME=${MAPR_HOME:-/opt/mapr}
KAFKA_HOME="${KAFKA_HOME:-__INSTALL__}"
KAFKA_CONNECT_CONF_FILE="${KAFKA_CONNECT_CONF_FILE:-${KAFKA_HOME}/config/connect-distributed.properties}"
LOGFILE_BASE=${LOGFILE_BASE:-${KAFKA_HOME}/var/log/kafka-connect/verify_service}
PID_FILE=${MAPR_HOME}/pid/kafka-connect.pid

EXIT_SUCCESS=0
EXIT_NOT_RUNNING=1
EXIT_RUNNING_NOT_RESPONDING=2
EXIT_USAGE=3
EXIT_HTTP_ERROR=4
CONNECT_TIMEOUT=15
USAGE="$0 [-q]"
QUIET=0
NOW=`date "+%Y%m%d_%H%M%S"`

if [ $# -eq 1 ] && [ "$1" == '-q' ]; then
    QUIET=1
elif [ $# -ge 1 ]; then
    echo $USAGE
    exit $EXIT_USAGE
fi

# Create log directory
mkdir -p "${LOGFILE_BASE%/*}"

# Check if the process is running
echo "Starting verifier at $(date)" >> $LOGFILE_BASE.$NOW
if [ -e "$PID_FILE" ] || [ -h "$PID_FILE" ]; then
    kafka_connect_pid=$(cat $PID_FILE 2> /dev/null)
    if [ $? -ne 0 ]; then
        PID_FILE=$(ls -l $PID_FILE | awk '{print $11}')
        kafka_connect_pid=$(cat $PID_FILE 2> /dev/null)
    fi
    if [ -z "$kafka_connect_pid" ]; then
        echo "ERROR - could not get pid for kafka-connect" >> $LOGFILE_BASE.$NOW
        exit $EXIT_NOT_RUNNING
    fi
    echo "checking to see if pid $kafka_connect_pid is alive" >> $LOGFILE_BASE.$NOW
    if kill -s 0 $kafka_connect_pid ; then
        echo "pid $kafka_connect_pid is alive" >> $LOGFILE_BASE.$NOW
        RC=$EXIT_RUNNING_NOT_RESPONDING
    else
        echo "pid $kafka_connect_pid is NOT running" >> $LOGFILE_BASE.$NOW
        [ $QUIET -eq 1 ] || cat $LOGFILE_BASE.$NOW
        exit $EXIT_NOT_RUNNING
    fi
else
    echo "no pid file, kafka-connect is NOT running" >> $LOGFILE_BASE.$NOW
    [ $QUIET -eq 1 ] || cat $LOGFILE_BASE.$NOW
    exit $EXIT_NOT_RUNNING
fi

# Check if the process is responding
echo "checking to see if kafka-connect pid $kafka_connect_pid is responsive" >> $LOGFILE_BASE.$NOW
listeners=$(grep listeners "$KAFKA_CONNECT_CONF_FILE" | cut -d'=' -f 2 | sed -e 's/ //g')
protocol=$(echo $listeners | cut -d':' -f 1 | sed -e 's/ //g')
kafka_connect_port=$(echo $listeners | cut -d':' -f 3 | sed -e 's/ //g')
kafka_connect_ip=$(hostname -i | head -n 1 | cut -d' ' -f1)
if [ "$protocol" == "https" ]; then
  # Getting MAPRSASL token
  token=$(java -cp `mapr classpath` com.mapr.security.client.examples.MapRClient gettoken -url "$protocol://${kafka_connect_ip}:${kafka_connect_port}" 2> /dev/null \
  |  grep 'Obtained challenge string' \
  |  sed -E 's/Obtained challenge string (.*)/\1/')
  OUTPUT=$(curl -s --write-out '%{http_code}' -k -H "Authorization: MAPR-Negotiate ${token}" -umapr:mapr "$protocol://${kafka_connect_ip}:${kafka_connect_port}")
else
  OUTPUT=$(curl -s --write-out '%{http_code}' "$protocol://${kafka_connect_ip}:${kafka_connect_port}")
fi

CRC=$?
if [ $CRC -ne 0 ]; then
    echo "kafka-connect didn't respond - rc=$CRC, output = $OUTPUT" >> $LOGFILE_BASE.$NOW
else
    echo "kafka-connect responded - rc=$CRC, output = $OUTPUT" >> $LOGFILE_BASE.$NOW
    http_code=${OUTPUT: -3}
    if [ $http_code -ne 200 ]; then
      RC=$EXIT_HTTP_ERROR
    else
      RC=$EXIT_SUCCESS
    fi
fi
[ $QUIET -eq 1 ] || cat $LOGFILE_BASE.$NOW
exit $RC
