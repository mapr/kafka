#!/bin/bash

MAPR_HOME=${MAPR_HOME:-/opt/mapr}
export MAPR_TICKETFILE_LOCATION=${MAPR_TICKETFILE_LOCATION:-"${MAPR_HOME}/conf/mapruserticket"}
KAFKA_VERSION=`cat "${MAPR_HOME}/kafka/kafkaversion"`
KAFKA_HOME=${KAFKA_HOME:-${MAPR_HOME}/kafka/kafka-${KAFKA_VERSION}}
NOW=`date "+%Y%m%d_%H%M%S"`
LOGFILE_BASE=${LOGFILE_BASE:-${KAFKA_HOME}/logs/verify_service.${NOW}.log}
PID_FILE=${MAPR_HOME}/pid/kafka-connect.pid
KAFKA_CONNECT_PORT=8083

EXIT_SUCCESS=0
EXIT_NOT_RUNNING=1
EXIT_RUNNING_NOT_RESPONDING=2
EXIT_USAGE=3
EXIT_HTTP_ERROR=4
CONNECT_TIMEOUT=15
USAGE="$0 [-q]"
QUIET=0

if [ $# -eq 1 ] && [ "$1" == '-q' ]; then
    QUIET=1
elif [ $# -ge 1 ]; then
    echo $USAGE
    exit $EXIT_USAGE
fi

# Check if the process is running
echo "Starting verifier at $(date)" >> $LOGFILE_BASE
if [ -e "$PID_FILE" ] || [ -h "$PID_FILE" ]; then
    kafka_connect_pid=$(cat $PID_FILE 2> /dev/null)
    if [ $? -ne 0 ]; then
        PID_FILE=$(ls -l $PID_FILE | awk '{print $11}')
        kafka_connect_pid=$(cat $PID_FILE 2> /dev/null)
    fi
    if [ -z "$kafka_connect_pid" ]; then
        echo "ERROR - could not get pid for kafka-connect" >> $LOGFILE_BASE
        exit $EXIT_NOT_RUNNING
    fi
    echo "checking to see if pid $kafka_connect_pid is alive" >> $LOGFILE_BASE
    if kill -s 0 $kafka_connect_pid ; then
        echo "pid $kafka_connect_pid is alive" >> $LOGFILE_BASE
        RC=$EXIT_RUNNING_NOT_RESPONDING
    else
        echo "pid $kafka_connect_pid is NOT running" >> $LOGFILE_BASE
        [ $QUIET -eq 1 ] || cat $LOGFILE_BASE
        exit $EXIT_NOT_RUNNING
    fi
else
    echo "no pid file, kafka-connect is NOT running" >> $LOGFILE_BASE
    [ $QUIET -eq 1 ] || cat $LOGFILE_BASE
    exit $EXIT_NOT_RUNNING
fi

# Check if the process is responding
echo "checking to see if kafka-connect pid $kafka_connect_pid is responsive" >> $LOGFILE_BASE
kafka_connect_ip=$(hostname -i | head -n 1 | cut -d' ' -f1)
secure=$(head -1 "${MAPR_HOME}"/conf/mapr-clusters.conf | grep -o 'secure=\w*' | cut -d= -f2)
if [ "$secure" == "true" ]; then
  # Getting MAPRSASL token
  token=$(java -cp `mapr classpath` com.mapr.security.client.examples.MapRClient gettoken -url "https://${kafka_connect_ip}:${KAFKA_CONNECT_PORT}" 2> /dev/null \
  |  grep 'Obtained challenge string' \
  |  sed -E 's/Obtained challenge string (.*)/\1/')
  OUTPUT=$(curl --noproxy '*' -s --write-out '%{http_code}' -k -H "Authorization: MAPR-Negotiate ${token}" "https://${kafka_connect_ip}:${KAFKA_CONNECT_PORT}")
else
  OUTPUT=$(curl --noproxy '*' -s --write-out '%{http_code}' "http://${kafka_connect_ip}:${KAFKA_CONNECT_PORT}")
fi

CRC=$?
if [ $CRC -ne 0 ]; then
    echo "kafka-connect didn't respond - rc=$CRC, output = $OUTPUT" >> $LOGFILE_BASE
else
    echo "kafka-connect responded - rc=$CRC, output = $OUTPUT" >> $LOGFILE_BASE
    http_code=${OUTPUT: -3}
    if [ $http_code -ne 200 ]; then
      RC=$EXIT_HTTP_ERROR
    else
      RC=$EXIT_SUCCESS
    fi
fi
[ $QUIET -eq 1 ] || cat $LOGFILE_BASE
exit $RC
